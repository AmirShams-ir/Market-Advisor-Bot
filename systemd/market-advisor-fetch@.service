[Unit]
Description=Market Advisor Bot data fetch (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=amir
WorkingDirectory=/home/amir/Market-Advisor-Bot
EnvironmentFile=/home/amir/Market-Advisor-Bot/.env
ExecStart=/usr/bin/python3 /home/amir/Market-Advisor-Bot/core/fetcher.py --symbol %i --timeframe %I
